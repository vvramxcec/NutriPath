# NutriPath — environment configuration
# Copy to `.env` (local dev) and never commit real secrets.

# --- Supabase (client-side, safe to expose) ---
# From Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- LLM (server-side ONLY — never ship in the app) ---
# Provider: gemini (default) or anthropic
LLM_PROVIDER=gemini
# Gemini key — https://aistudio.google.com/apikey (default model: gemini-2.5-flash)
# Set via: supabase secrets set GEMINI_API_KEY=...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Anthropic (only used when LLM_PROVIDER=anthropic) — https://console.anthropic.com
# Set via: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
