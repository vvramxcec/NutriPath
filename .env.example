# NutriPath — environment configuration
# Copy to `.env` (local dev) and never commit real secrets.

# --- Supabase (client-side, safe to expose) ---
# From Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Anthropic (server-side ONLY — never ship in the app) ---
# Set via: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5
